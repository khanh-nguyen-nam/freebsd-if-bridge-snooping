+atf_test_case "mdb_unknown_multicast_flood" "cleanup"
+mdb_unknown_multicast_flood_head()
+{
+	atf_set descr 'bridge MDB keeps unknown IPv4 multicast flood fallback'
+	atf_set require.user root
+	atf_set require.progs "tcpdump timeout"
+}
+
+mdb_unknown_multicast_flood_body()
+{
+	vnet_init
+	vnet_init_bridge
+
+	bridge_mdb_vnet_topology_create
+
+	capture="${PWD}/mdb_unknown_multicast_flood.tcpdump"
+	rm -f "${capture}"
+
+	jexec mdbs route add -net 224.0.0.0/4 \
+	    -interface ${mdb_sender_epair}b >/dev/null 2>&1 || true
+	jexec mdbi sh -c "timeout 5 tcpdump --immediate-mode -n \
+	    -i ${mdb_idle_epair}b -c 1 \
+	    'icmp and dst host 239.1.1.1' > ${capture} 2>&1" &
+	tcpdumppid=$!
+	sleep 1
+
+	jexec mdbs ping -c 1 -t 1 239.1.1.1 >/dev/null 2>&1 || true
+	wait ${tcpdumppid}
+	status=$?
+
+	cat "${capture}"
+	if [ ${status} -ne 0 ]; then
+		atf_fail "unknown IPv4 multicast did not flood to idle port"
+	fi
+}
+
+mdb_unknown_multicast_flood_cleanup()
+{
+	vnet_cleanup
+}
