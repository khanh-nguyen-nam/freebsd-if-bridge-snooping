+atf_test_case "mdb_counters" "cleanup"
+mdb_counters_head()
+{
+	atf_set descr 'bridge MDB observability counters track entries/prune/flood'
+	atf_set require.user root
+	atf_set require.progs "cc"
+}
+
+mdb_counters_body()
+{
+	vnet_init
+	vnet_init_bridge
+
+	bridge_mdb_vnet_topology_create
+
+	# Snooping is off by default; enable it so the MDB learns and prunes.
+	atf_check -s exit:0 -o ignore \
+	    sysctl net.link.bridge.igmp_snooping=1
+
+	# A fresh VNET starts with zeroed counters, but reset the event
+	# counters explicitly so the assertions below are independent of any
+	# earlier control traffic on the bridge.
+	atf_check -s exit:0 -o ignore sysctl net.link.bridge.mdb_prune_hits=0
+	atf_check -s exit:0 -o ignore sysctl net.link.bridge.mdb_flood_fallback=0
+
+	bridge_mdb_compile_join_helper
+
+	# Join 239.1.1.1 so the MDB learns exactly one group entry.
+	jexec mdbl /tmp/mcast_join_bridge_test 239.1.1.1 192.0.2.2 30 &
+	joiner_pid=$!
+	sleep 2
+
+	# The learned group must show up in the entry gauge.
+	atf_check -o match:'^[1-9][0-9]*$' \
+	    sysctl -n net.link.bridge.mdb_entries
+
+	jexec mdbs route add -net 224.0.0.0/4 \
+	    -interface ${mdb_sender_epair}b >/dev/null 2>&1 || true
+
+	# Traffic to the joined group is pruned to the listener (prune hit).
+	jexec mdbs ping -c 2 -t 1 239.1.1.1 >/dev/null 2>&1 || true
+	# Traffic to an unjoined group has no listener state and floods.
+	jexec mdbs ping -c 2 -t 1 239.9.9.9 >/dev/null 2>&1 || true
+
+	kill ${joiner_pid} 2>/dev/null || true
+
+	atf_check -o match:'^[1-9][0-9]*$' \
+	    sysctl -n net.link.bridge.mdb_prune_hits
+	atf_check -o match:'^[1-9][0-9]*$' \
+	    sysctl -n net.link.bridge.mdb_flood_fallback
+}
+
+mdb_counters_cleanup()
+{
+	rm -f /tmp/mcast_join_bridge_test /tmp/mcast_join_bridge_test.c
+	vnet_cleanup
+}
