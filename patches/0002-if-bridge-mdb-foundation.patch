+bridge_mdb_vnet_topology_create()
+{
+	mdb_sender_epair=$(vnet_mkepair)
+	mdb_listener_epair=$(vnet_mkepair)
+	mdb_idle_epair=$(vnet_mkepair)
+
+	vnet_mkjail mdbs ${mdb_sender_epair}b
+	vnet_mkjail mdbl ${mdb_listener_epair}b
+	vnet_mkjail mdbi ${mdb_idle_epair}b
+
+	jexec mdbs ifconfig ${mdb_sender_epair}b 192.0.2.1/24 up
+	jexec mdbl ifconfig ${mdb_listener_epair}b 192.0.2.2/24 up
+	jexec mdbi ifconfig ${mdb_idle_epair}b 192.0.2.3/24 up
+
+	mdb_bridge=$(vnet_mkbridge)
+	ifconfig ${mdb_bridge} up
+
+	ifconfig ${mdb_sender_epair}a up
+	ifconfig ${mdb_listener_epair}a up
+	ifconfig ${mdb_idle_epair}a up
+	ifconfig ${mdb_bridge} addm ${mdb_sender_epair}a
+	ifconfig ${mdb_bridge} addm ${mdb_listener_epair}a
+	ifconfig ${mdb_bridge} addm ${mdb_idle_epair}a
+}
+
+atf_test_case "mdb_vnet_topology" "cleanup"
+mdb_vnet_topology_head()
+{
+	atf_set descr 'bridge multicast database VNET topology scaffold'
+	atf_set require.user root
+}
+
+mdb_vnet_topology_body()
+{
+	vnet_init
+	vnet_init_bridge
+
+	bridge_mdb_vnet_topology_create
+
+	atf_check -s exit:0 -o inline:"3\n" \
+	    sh -c "ifconfig ${mdb_bridge} | grep member: | wc -l | xargs"
+	atf_check -s exit:0 -o ignore \
+	    jexec mdbs ping -c 1 -t 1 192.0.2.2
+	atf_check -s exit:0 -o ignore \
+	    jexec mdbs ping -c 1 -t 1 192.0.2.3
+}
+
+mdb_vnet_topology_cleanup()
+{
+	vnet_cleanup
+}
