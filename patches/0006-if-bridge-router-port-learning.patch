+atf_test_case "mdb_router_forward" "cleanup"
+mdb_router_forward_head()
+{
+	atf_set descr 'bridge forwards learned multicast to IGMP-query router ports'
+	atf_set require.user root
+	atf_set require.progs "cc tcpdump timeout"
+}
+
+mdb_router_forward_body()
+{
+	vnet_init
+	vnet_init_bridge
+
+	bridge_mdb_router_topology_create
+
+	# Snooping is off by default; enable it so the MDB learns listener and
+	# router state and the forwarding path prunes accordingly.
+	atf_check -s exit:0 -o ignore \
+	    sysctl net.link.bridge.igmp_snooping=1
+
+	bridge_mdb_compile_join_helper
+	bridge_mdb_compile_query_helper
+
+	# Listener joins 239.1.1.1 on its port.
+	jexec mdbl /tmp/mcast_join_bridge_test 239.1.1.1 192.0.2.2 30 &
+	joiner_pid=$!
+	sleep 2
+
+	# Router jail emits IGMP membership queries; the bridge should learn
+	# its port as a multicast-router port.
+	jexec mdbr /tmp/mcast_query_bridge_test 192.0.2.4 3
+	sleep 1
+
+	# The router port must have been learned.
+	atf_check -o match:'^[1-9][0-9]*$' \
+	    sysctl -n net.link.bridge.mdb_routers
+
+	jexec mdbs route add -net 224.0.0.0/4 \
+	    -interface ${mdb_sender_epair}b >/dev/null 2>&1 || true
+
+	rcap="${PWD}/mdb_router.tcpdump"
+	icap="${PWD}/mdb_router_idle.tcpdump"
+	rm -f "${rcap}" "${icap}"
+
+	# The router port should receive the group even though it never joined;
+	# the idle port must still be pruned.
+	jexec mdbr sh -c "timeout 4 tcpdump --immediate-mode -n \
+	    -i ${mdb_router_epair}b -c 1 \
+	    'icmp and dst host 239.1.1.1' > ${rcap} 2>&1" &
+	router_tcpdump=$!
+	jexec mdbi sh -c "timeout 4 tcpdump --immediate-mode -n \
+	    -i ${mdb_idle_epair}b -c 1 \
+	    'icmp and dst host 239.1.1.1' > ${icap} 2>&1" &
+	idle_tcpdump=$!
+	sleep 1
+
+	jexec mdbs ping -c 3 -t 1 239.1.1.1 >/dev/null 2>&1 || true
+
+	wait ${router_tcpdump}
+	router_status=$?
+	wait ${idle_tcpdump}
+	idle_status=$?
+
+	kill ${joiner_pid} 2>/dev/null || true
+
+	# router_status 0 means the router port captured the frame (correct).
+	if [ ${router_status} -ne 0 ]; then
+		atf_fail "router port did not receive multicast; router learning failed"
+	fi
+	# idle_status 0 means the idle port captured a frame, i.e. pruning broke.
+	if [ ${idle_status} -eq 0 ]; then
+		cat "${icap}"
+		atf_fail "idle port received multicast that MDB should have pruned"
+	fi
+}
+
+mdb_router_forward_cleanup()
+{
+	rm -f /tmp/mcast_join_bridge_test /tmp/mcast_join_bridge_test.c
+	rm -f /tmp/mcast_query_bridge_test /tmp/mcast_query_bridge_test.c
+	vnet_cleanup
+}
+
