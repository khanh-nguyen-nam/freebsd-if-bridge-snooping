 	callout_init_mtx(&sc->sc_brcallout, &sc->sc_rt_mtx, 0);
+	callout_init_mtx(&sc->sc_mdbcallout, &sc->sc_rt_mtx, 0);
 
 	CK_LIST_INIT(&sc->sc_iflist);
 	CK_LIST_INIT(&sc->sc_spanlist);
@@ -939,6 +986,241 @@ bridge_rsvd_link_local_enabled(struct bridge_softc *sc, const uint8_t *dst)
 	return ((sc->sc_group_fwd_mask & bit) != 0);
 }
 
+static void
+bridge_mdb_init(struct bridge_softc *sc)
+{
+	CK_LIST_INIT(&sc->sc_mdb);
+	sc->sc_mdbcnt = 0;
+	sc->sc_mdbmembercnt = 0;
+}
+
+static int
+bridge_mdb_key_init(struct bridge_mdb_key *key, sa_family_t family,
+    const void *addr, ether_vlanid_t vlan)
+{
+	memset(key, 0, sizeof(*key));
+	key->bmk_family = family;
+	key->bmk_vlan = vlan;
+
+	switch (family) {
+#ifdef INET
+	case AF_INET:
+		memcpy(&key->bmk_addr.bmk_ip4, addr, sizeof(struct in_addr));
+		return (0);
+#endif
+#ifdef INET6
+	case AF_INET6:
+		memcpy(&key->bmk_addr.bmk_ip6, addr, sizeof(struct in6_addr));
+		return (0);
+#endif
+	default:
+		return (EAFNOSUPPORT);
+	}
+}
+
+static bool
+bridge_mdb_key_equal(const struct bridge_mdb_key *a,
+    const struct bridge_mdb_key *b)
+{
+	if (a->bmk_family != b->bmk_family || a->bmk_vlan != b->bmk_vlan)
+		return (false);
+
+	switch (a->bmk_family) {
+#ifdef INET
+	case AF_INET:
+		return (memcmp(&a->bmk_addr.bmk_ip4, &b->bmk_addr.bmk_ip4,
+		    sizeof(struct in_addr)) == 0);
+#endif
+#ifdef INET6
+	case AF_INET6:
+		return (memcmp(&a->bmk_addr.bmk_ip6, &b->bmk_addr.bmk_ip6,
+		    sizeof(struct in6_addr)) == 0);
+#endif
+	default:
+		return (false);
+	}
+}
+
+static struct bridge_mdb_entry *
+bridge_mdb_lookup(struct bridge_softc *sc, const struct bridge_mdb_key *key)
+{
+	struct bridge_mdb_entry *bmd;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CK_LIST_FOREACH(bmd, &sc->sc_mdb, bmd_next) {
+		if (bridge_mdb_key_equal(&bmd->bmd_key, key))
+			return (bmd);
+	}
+
+	return (NULL);
+}
+
+static struct bridge_mdb_member *
+bridge_mdb_member_lookup(struct bridge_mdb_entry *bmd,
+    struct bridge_iflist *bif)
+{
+	struct bridge_mdb_member *bmm;
+
+	CK_LIST_FOREACH(bmm, &bmd->bmd_members, bmm_next) {
+		if (bmm->bmm_bif == bif)
+			return (bmm);
+	}
+
+	return (NULL);
+}
+
+static void
+bridge_mdb_destroy_entry(struct bridge_softc *sc, struct bridge_mdb_entry *bmd)
+{
+	struct bridge_mdb_member *bmm;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	while ((bmm = CK_LIST_FIRST(&bmd->bmd_members)) != NULL) {
+		CK_LIST_REMOVE(bmm, bmm_next);
+		sc->sc_mdbmembercnt--;
+		free(bmm, M_DEVBUF);
+	}
+
+	CK_LIST_REMOVE(bmd, bmd_next);
+	sc->sc_mdbcnt--;
+	free(bmd, M_DEVBUF);
+}
+
+static bool
+bridge_mdb_remove_member(struct bridge_softc *sc, struct bridge_mdb_entry *bmd,
+    struct bridge_mdb_member *bmm)
+{
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CK_LIST_REMOVE(bmm, bmm_next);
+	sc->sc_mdbmembercnt--;
+	free(bmm, M_DEVBUF);
+
+	if (!CK_LIST_EMPTY(&bmd->bmd_members))
+		return (false);
+
+	CK_LIST_REMOVE(bmd, bmd_next);
+	sc->sc_mdbcnt--;
+	free(bmd, M_DEVBUF);
+	return (true);
+}
+
+static int
+bridge_mdb_add_member(struct bridge_softc *sc, sa_family_t family,
+    const void *addr, ether_vlanid_t vlan, struct bridge_iflist *bif,
+    unsigned int lifetime)
+{
+	struct bridge_mdb_entry *bmd, *new_bmd;
+	struct bridge_mdb_member *bmm, *new_bmm;
+	struct bridge_mdb_key key;
+	bool created_bmd;
+	int error;
+
+	error = bridge_mdb_key_init(&key, family, addr, vlan);
+	if (error != 0)
+		return (error);
+
+	new_bmd = malloc(sizeof(*new_bmd), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (new_bmd != NULL) {
+		new_bmd->bmd_key = key;
+		CK_LIST_INIT(&new_bmd->bmd_members);
+	}
+
+	new_bmm = malloc(sizeof(*new_bmm), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (new_bmm != NULL)
+		new_bmm->bmm_bif = bif;
+
+	created_bmd = false;
+	BRIDGE_RT_LOCK(sc);
+	bmd = bridge_mdb_lookup(sc, &key);
+	if (bmd == NULL) {
+		if (new_bmd == NULL) {
+			error = ENOMEM;
+			goto out;
+		}
+		bmd = new_bmd;
+		new_bmd = NULL;
+		CK_LIST_INSERT_HEAD(&sc->sc_mdb, bmd, bmd_next);
+		sc->sc_mdbcnt++;
+		created_bmd = true;
+	}
+
+	bmm = bridge_mdb_member_lookup(bmd, bif);
+	if (bmm == NULL) {
+		if (new_bmm == NULL) {
+			if (created_bmd)
+				bridge_mdb_destroy_entry(sc, bmd);
+			error = ENOMEM;
+			goto out;
+		}
+		bmm = new_bmm;
+		new_bmm = NULL;
+		CK_LIST_INSERT_HEAD(&bmd->bmd_members, bmm, bmm_next);
+		sc->sc_mdbmembercnt++;
+	}
+	bmm->bmm_expire = lifetime == 0 ? 0 : time_uptime + lifetime;
+out:
+	BRIDGE_RT_UNLOCK(sc);
+
+	if (new_bmd != NULL)
+		free(new_bmd, M_DEVBUF);
+	if (new_bmm != NULL)
+		free(new_bmm, M_DEVBUF);
+
+	return (error);
+}
+
+static void
+bridge_mdb_flush_member(struct bridge_softc *sc, struct bridge_iflist *bif)
+{
+	struct bridge_mdb_entry *bmd, *nbmd;
+	struct bridge_mdb_member *bmm, *nbmm;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CK_LIST_FOREACH_SAFE(bmd, &sc->sc_mdb, bmd_next, nbmd) {
+		CK_LIST_FOREACH_SAFE(bmm, &bmd->bmd_members, bmm_next, nbmm) {
+			if (bmm->bmm_bif == bif &&
+			    bridge_mdb_remove_member(sc, bmd, bmm))
+				break;
+		}
+	}
+}
+
+static void
+bridge_mdb_prune(struct bridge_softc *sc)
+{
+	struct bridge_mdb_entry *bmd, *nbmd;
+	struct bridge_mdb_member *bmm, *nbmm;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CK_LIST_FOREACH_SAFE(bmd, &sc->sc_mdb, bmd_next, nbmd) {
+		CK_LIST_FOREACH_SAFE(bmm, &bmd->bmd_members, bmm_next, nbmm) {
+			if (bmm->bmm_expire != 0 &&
+			    time_uptime >= bmm->bmm_expire &&
+			    bridge_mdb_remove_member(sc, bmd, bmm))
+				break;
+		}
+	}
+}
+
+static void
+bridge_mdb_fini(struct bridge_softc *sc)
+{
+	struct bridge_mdb_entry *bmd;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	while ((bmd = CK_LIST_FIRST(&sc->sc_mdb)) != NULL)
+		bridge_mdb_destroy_entry(sc, bmd);
+
+	KASSERT(sc->sc_mdbcnt == 0 && sc->sc_mdbmembercnt == 0,
+	    ("%s: MDB entries remain", __func__));
+}
+
 static void
 bridge_clone_destroy_cb(struct epoch_context *ctx)
 {
@@ -979,6 +1261,11 @@ bridge_clone_destroy(struct if_clone *ifc, struct ifnet *ifp, uint32_t flags)
 	BRIDGE_UNLOCK(sc);
 
 	callout_drain(&sc->sc_brcallout);
+	callout_drain(&sc->sc_mdbcallout);
+
+	BRIDGE_RT_LOCK(sc);
+	bridge_mdb_fini(sc);
+	BRIDGE_RT_UNLOCK(sc);
 
 	BRIDGE_LIST_LOCK();
 	LIST_REMOVE(sc, sc_list);
@@ -1306,6 +1593,7 @@ bridge_delete_member(struct bridge_softc *sc, struct bridge_iflist *bif,
 	bridge_linkcheck(sc);
 	bridge_mutecaps(sc);	/* recalcuate now this interface is removed */
 	BRIDGE_RT_LOCK(sc);
+	bridge_mdb_flush_member(sc, bif);
 	bridge_rtdelete(sc, ifs, IFBF_FLUSHALL);
 	BRIDGE_RT_UNLOCK(sc);
 	KASSERT(bif->bif_addrcnt == 0,
@@ -2376,6 +2664,8 @@ bridge_init(void *xsc)
 	BRIDGE_LOCK(sc);
 	callout_reset(&sc->sc_brcallout, bridge_rtable_prune_period * hz,
 	    bridge_timer, sc);
+	callout_reset(&sc->sc_mdbcallout, BRIDGE_MDB_PRUNE_PERIOD * hz,
+	    bridge_mdb_timer, sc);
 
 	ifp->if_drv_flags |= IFF_DRV_RUNNING;
 	bstp_init(&sc->sc_stp);		/* Initialize Spanning Tree */
@@ -2400,6 +2690,7 @@ bridge_stop(struct ifnet *ifp)
 
 	BRIDGE_RT_LOCK(sc);
 	callout_stop(&sc->sc_brcallout);
+	callout_stop(&sc->sc_mdbcallout);
 
 	bstp_stop(&sc->sc_stp);
 
@@ -3632,6 +3923,27 @@ bridge_timer(void *arg)
 	CURVNET_RESTORE();
 }
 
+/*
+ * bridge_mdb_timer:
+ *
+ *	Aging timer for the multicast database.
+ */
+static void
+bridge_mdb_timer(void *arg)
+{
+	struct bridge_softc *sc = arg;
+
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CURVNET_SET(sc->sc_ifp->if_vnet);
+	bridge_mdb_prune(sc);
+
+	if (sc->sc_ifp->if_drv_flags & IFF_DRV_RUNNING)
+		callout_reset(&sc->sc_mdbcallout,
+		    BRIDGE_MDB_PRUNE_PERIOD * hz, bridge_mdb_timer, sc);
+	CURVNET_RESTORE();
+}
