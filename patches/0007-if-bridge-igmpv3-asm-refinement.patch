 This is disabled by default; forwarding falls back to flooding whenever no
 listener state is known, for non-IP multicast, and for exempt link-local
 control traffic.
+.Pp
+IGMPv3 group records are reduced conservatively to any-source
+.Pq (*,G)
+listener state.
+Records that express positive interest in a group, namely
+EXCLUDE-mode records with any source list and INCLUDE-mode or
+ALLOW_NEW_SOURCES records with a non-empty source list, create or refresh
+listener state for the ingress port.
+Source lists are not used to narrow delivery, so a source-specific join may
+receive traffic from more sources than requested but never fewer.
+Records that only revoke interest, such as BLOCK_OLD_SOURCES or a
+CHANGE_TO_INCLUDE_MODE record with an empty source list (the IGMPv3 leave),
+never remove listener state immediately; state expires through aging, as with
+an IGMPv2 leave.
 .Pp
 Member ports on which IGMP membership queries are seen are additionally
 learned as multicast-router ports.
--- a/tests/sys/net/if_bridge_test.sh
+++ b/tests/sys/net/if_bridge_test.sh
@@ -975,7 +975,46 @@
 CSRC
 	cc -o /tmp/mcast_query_bridge_test /tmp/mcast_query_bridge_test.c || \
 	    atf_skip "could not compile mcast_query helper"
+}
+
+# Compile a helper that performs an IGMPv3 source-specific join
+# (IP_ADD_SOURCE_MEMBERSHIP) and holds the socket open.  On an IGMPv3 stack
+# this makes the kernel emit INCLUDE-family group records rather than a
+# version 2 report.  argv: <group> <source> <local-interface-addr> <secs>.
+bridge_mdb_compile_source_join_helper()
+{
+	cat > /tmp/mcast_source_join_bridge_test.c << 'CSRC'
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+int main(int argc, char **argv)
+{
+	struct ip_mreq_source mreqs;
+	int s, on = 1, secs;
+	if (argc != 5) return 1;
+	secs = atoi(argv[4]);
+	s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (s < 0) return 1;
+	setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+	memset(&mreqs, 0, sizeof(mreqs));
+	mreqs.imr_multiaddr.s_addr = inet_addr(argv[1]);
+	mreqs.imr_sourceaddr.s_addr = inet_addr(argv[2]);
+	mreqs.imr_interface.s_addr = inet_addr(argv[3]);
+	if (setsockopt(s, IPPROTO_IP, IP_ADD_SOURCE_MEMBERSHIP,
+	    &mreqs, sizeof(mreqs)) < 0)
+		return 1;
+	sleep(secs);
+	return 0;
 }
+CSRC
+	cc -o /tmp/mcast_source_join_bridge_test \
+	    /tmp/mcast_source_join_bridge_test.c || \
+	    atf_skip "could not compile mcast_source_join helper"
+}
 
