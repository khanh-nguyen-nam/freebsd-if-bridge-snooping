+static struct bridge_mdb_router *
+bridge_mdb_router_lookup(struct bridge_softc *sc, ether_vlanid_t vlan,
+    struct bridge_iflist *bif)
+{
+	struct bridge_mdb_router *bmr;
+
+	BRIDGE_RT_LOCK_OR_NET_EPOCH_ASSERT(sc);
+
+	CK_LIST_FOREACH(bmr, &sc->sc_mdbrouters, bmr_next) {
+		if (bmr->bmr_bif == bif && bmr->bmr_vlan == vlan)
+			return (bmr);
+	}
+
+	return (NULL);
+}
+
 /*
  * MDB nodes are read by bridge_mdb_lookup()/bridge_mdb_forward() under the
  * net epoch without holding BRIDGE_RT_LOCK.  Unlink them synchronously under
@@ -1178,6 +1238,26 @@ bridge_mdb_destroy_entry_cb(struct epoch_context *ctx)
 	free(bmd, M_DEVBUF);
 }
 
+static void
+bridge_mdb_destroy_router_cb(struct epoch_context *ctx)
+{
+	struct bridge_mdb_router *bmr;
+
+	bmr = __containerof(ctx, struct bridge_mdb_router, bmr_epoch_ctx);
+	free(bmr, M_DEVBUF);
+}
+
+static void
+bridge_mdb_remove_router(struct bridge_softc *sc, struct bridge_mdb_router *bmr)
+{
+	BRIDGE_RT_LOCK_ASSERT(sc);
+
+	CK_LIST_REMOVE(bmr, bmr_next);
+	sc->sc_mdbroutercnt--;
+	counter_u64_add(V_mdb_routers, -1);
+	NET_EPOCH_CALL(bridge_mdb_destroy_router_cb, &bmr->bmr_epoch_ctx);
+}
