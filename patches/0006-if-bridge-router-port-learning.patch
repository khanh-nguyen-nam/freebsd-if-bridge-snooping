+# Compile a helper that emits IGMPv2 general membership queries, standing in
+# for a multicast router/querier.  It uses a raw IPPROTO_IGMP socket so the
+# kernel builds the IP header; only the 8-byte IGMP body (with checksum) is
+# supplied.  argv: <local-interface-addr> <count>.
+bridge_mdb_compile_query_helper()
+{
+	cat > /tmp/mcast_query_bridge_test.c << 'CSRC'
+#include <sys/types.h>
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/igmp.h>
+#include <arpa/inet.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+static unsigned short
+cksum(const unsigned char *b, int len)
+{
+	unsigned long sum = 0;
+	int i;
+
+	for (i = 0; i + 1 < len; i += 2)
+		sum += (b[i] << 8) | b[i + 1];
+	if (len & 1)
+		sum += b[len - 1] << 8;
+	while (sum >> 16)
+		sum = (sum & 0xffff) + (sum >> 16);
+	return (unsigned short)(~sum);
+}
+
+int
+main(int argc, char **argv)
+{
+	struct sockaddr_in dst;
+	struct in_addr mif;
+	unsigned char igmp[8];
+	unsigned short sum;
+	unsigned char ttl = 1;
+	int s, i, n;
+
+	if (argc != 3)
+		return 1;
+	n = atoi(argv[2]);
+
+	s = socket(AF_INET, SOCK_RAW, IPPROTO_IGMP);
+	if (s < 0)
+		return 1;
+
+	mif.s_addr = inet_addr(argv[1]);
+	if (setsockopt(s, IPPROTO_IP, IP_MULTICAST_IF, &mif, sizeof(mif)) < 0)
+		return 1;
+	setsockopt(s, IPPROTO_IP, IP_MULTICAST_TTL, &ttl, sizeof(ttl));
+
+	memset(igmp, 0, sizeof(igmp));
+	igmp[0] = IGMP_HOST_MEMBERSHIP_QUERY;	/* 0x11 */
+	igmp[1] = 100;				/* max response time, 10s */
+	sum = cksum(igmp, sizeof(igmp));
+	igmp[2] = sum >> 8;
+	igmp[3] = sum & 0xff;
+
+	memset(&dst, 0, sizeof(dst));
+	dst.sin_family = AF_INET;
+	dst.sin_addr.s_addr = inet_addr("224.0.0.1");
+
+	for (i = 0; i < n; i++) {
+		if (sendto(s, igmp, sizeof(igmp), 0,
+		    (struct sockaddr *)&dst, sizeof(dst)) < 0)
+			return 1;
+		usleep(200000);
+	}
+	return 0;
+}
+CSRC
+	cc -o /tmp/mcast_query_bridge_test /tmp/mcast_query_bridge_test.c || \
+	    atf_skip "could not compile mcast_query helper"
+}
+
