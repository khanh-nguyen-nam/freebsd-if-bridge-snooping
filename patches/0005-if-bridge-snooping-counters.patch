+/*
+ * IGMP snooping runtime enable.  Default off: when disabled the bridge does
+ * not learn listener state and floods all multicast exactly as it did before
+ * the MDB was introduced.
+ */
+VNET_DEFINE_STATIC(int, igmp_snooping) = 0;
+#define	V_igmp_snooping	VNET(igmp_snooping)
+SYSCTL_INT(_net_link_bridge, OID_AUTO, igmp_snooping,
+    CTLFLAG_RWTUN | CTLFLAG_VNET, &VNET_NAME(igmp_snooping), 0,
+    "Enable IGMP snooping: prune IPv4 multicast to learned listener ports");
+
+/*
+ * Observability counters for the MDB / snooping path.  These let reviewers
+ * inspect learned state and fallback behavior without relying only on
+ * packet captures.  Writing any value to a counter zeroes it (stock
+ * sysctl_handle_counter_u64() behavior), so they must be CTLFLAG_RW.
+ */
+VNET_DEFINE_STATIC(counter_u64_t, mdb_entries);
+#define	V_mdb_entries	VNET(mdb_entries)
+SYSCTL_COUNTER_U64(_net_link_bridge, OID_AUTO, mdb_entries,
+    CTLFLAG_RW | CTLFLAG_VNET, &VNET_NAME(mdb_entries),
+    "Current number of multicast group entries in the bridge MDB");
+
+VNET_DEFINE_STATIC(counter_u64_t, mdb_prune_hits);
+#define	V_mdb_prune_hits	VNET(mdb_prune_hits)
+SYSCTL_COUNTER_U64(_net_link_bridge, OID_AUTO, mdb_prune_hits,
+    CTLFLAG_RW | CTLFLAG_VNET, &VNET_NAME(mdb_prune_hits),
+    "IPv4 multicast frames forwarded to a pruned set of MDB listeners");
+
+VNET_DEFINE_STATIC(counter_u64_t, mdb_flood_fallback);
+#define	V_mdb_flood_fallback	VNET(mdb_flood_fallback)
+SYSCTL_COUNTER_U64(_net_link_bridge, OID_AUTO, mdb_flood_fallback,
+    CTLFLAG_RW | CTLFLAG_VNET, &VNET_NAME(mdb_flood_fallback),
+    "IPv4 multicast frames flooded because no MDB listener state existed");
+
+VNET_DEFINE_STATIC(counter_u64_t, mdb_parse_reject);
+#define	V_mdb_parse_reject	VNET(mdb_parse_reject)
+SYSCTL_COUNTER_U64(_net_link_bridge, OID_AUTO, mdb_parse_reject,
+    CTLFLAG_RW | CTLFLAG_VNET, &VNET_NAME(mdb_parse_reject),
+    "Malformed or unsupported IGMP control packets rejected by snooping");
+
+VNET_DEFINE_STATIC(counter_u64_t, mdb_expired);
+#define	V_mdb_expired	VNET(mdb_expired)
+SYSCTL_COUNTER_U64(_net_link_bridge, OID_AUTO, mdb_expired,
+    CTLFLAG_RW | CTLFLAG_VNET, &VNET_NAME(mdb_expired),
+    "MDB listener entries removed due to membership aging");
+
