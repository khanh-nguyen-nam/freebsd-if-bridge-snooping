+# Extend the base sender/listener/idle topology with a fourth "router" jail
+# (mdbr) whose port stands in for a link to a multicast router/querier.
+bridge_mdb_router_topology_create()
+{
+	bridge_mdb_vnet_topology_create
+
+	mdb_router_epair=$(vnet_mkepair)
+	vnet_mkjail mdbr ${mdb_router_epair}b
+	jexec mdbr ifconfig ${mdb_router_epair}b 192.0.2.4/24 up
+	ifconfig ${mdb_router_epair}a up
+	ifconfig ${mdb_bridge} addm ${mdb_router_epair}a
+
+	# The router jail's routing table only knows its own /24; without a
+	# multicast route the IGMP query send fails with ENETUNREACH even
+	# though IP_MULTICAST_IF names this interface.
+	jexec mdbr route add -net 224.0.0.0/4 -interface ${mdb_router_epair}b
+}
+
