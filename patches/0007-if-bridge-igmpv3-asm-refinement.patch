+atf_test_case "mdb_igmpv3_source_join" "cleanup"
+mdb_igmpv3_source_join_head()
+{
+	atf_set descr 'bridge MDB learns ASM state from IGMPv3 source-specific joins'
+	atf_set require.user root
+	atf_set require.progs "cc tcpdump timeout"
+}
+
+mdb_igmpv3_source_join_body()
+{
+	vnet_init
+	vnet_init_bridge
+
+	bridge_mdb_vnet_topology_create
+
+	# Snooping is off by default; enable it so the MDB learns listener
+	# state and the forwarding path prunes to interested ports.
+	atf_check -s exit:0 -o ignore \
+	    sysctl net.link.bridge.igmp_snooping=1
+
+	# Pin the listener jail's IGMP to version 3 so the source-specific
+	# join below emits IGMPv3 INCLUDE-family records (TO_IN({S})) rather
+	# than a version 1/2 report -- the record class this test exercises.
+	atf_check -s exit:0 -o ignore \
+	    jexec mdbl sysctl net.inet.igmp.default_version=3
+
+	bridge_mdb_compile_source_join_helper
+
+	# Source-specific join of (192.0.2.1, 239.1.1.1) from the listener
+	# jail.  Before the ASM refinement the bridge ignored INCLUDE-family
+	# records and kept flooding; it must now reduce them to (*,G)
+	# listener state.
+	jexec mdbl /tmp/mcast_source_join_bridge_test 239.1.1.1 192.0.2.1 \
+	    192.0.2.2 30 &
+	joiner_pid=$!
+	sleep 2
+
+	# The INCLUDE-mode record must have created (*,G) state.
+	atf_check -o match:'^[1-9][0-9]*$' \
+	    sysctl -n net.link.bridge.mdb_entries
+
+	jexec mdbs route add -net 224.0.0.0/4 \
+	    -interface ${mdb_sender_epair}b >/dev/null 2>&1 || true
+
+	lcap="${PWD}/mdb_igmpv3_listener.tcpdump"
+	icap="${PWD}/mdb_igmpv3_idle.tcpdump"
+	rm -f "${lcap}" "${icap}"
+
+	# The listener port must receive the group it asked for (the ASM
+	# reduction over-delivers a source-specific request, never
+	# under-delivers it); the idle port must still be pruned.
+	jexec mdbl sh -c "timeout 4 tcpdump --immediate-mode -n \
+	    -i ${mdb_listener_epair}b -c 1 \
+	    'icmp and dst host 239.1.1.1' > ${lcap} 2>&1" &
+	listener_tcpdump=$!
+	jexec mdbi sh -c "timeout 4 tcpdump --immediate-mode -n \
+	    -i ${mdb_idle_epair}b -c 1 \
+	    'icmp and dst host 239.1.1.1' > ${icap} 2>&1" &
+	idle_tcpdump=$!
+	sleep 1
+
+	jexec mdbs ping -c 3 -t 1 239.1.1.1 >/dev/null 2>&1 || true
+
+	wait ${listener_tcpdump}
+	listener_status=$?
+	wait ${idle_tcpdump}
+	idle_status=$?
+
+	kill ${joiner_pid} 2>/dev/null || true
+
+	# listener_status 0 means the listener port captured the frame.
+	if [ ${listener_status} -ne 0 ]; then
+		atf_fail "listener port did not receive its source-joined group"
+	fi
+	# idle_status 0 means the idle port captured a frame, i.e. the ASM
+	# reduction created state but pruning delivered too broadly.
+	if [ ${idle_status} -eq 0 ]; then
+		cat "${icap}"
+		atf_fail "idle port received multicast that MDB should have pruned"
+	fi
+}
+
+mdb_igmpv3_source_join_cleanup()
+{
+	rm -f /tmp/mcast_source_join_bridge_test \
+	    /tmp/mcast_source_join_bridge_test.c
+	vnet_cleanup
+}
+
