 #endif
 
+/*
+ * Conservative router-port lifetime.  A member port is treated as leading to a
+ * multicast router for as long as IGMP membership queries keep arriving on it.
+ * This matches the standard "other querier present" interval
+ * (robustness * query-interval + max-response) and is refreshed by each query.
+ */
+#ifndef BRIDGE_MDB_ROUTER_MAXAGE
+#define	BRIDGE_MDB_ROUTER_MAXAGE	(2 * 125 + 5)
+#endif
+
 /*
  * List of capabilities to possibly mask on the member interface.
  */
@@ -324,6 +334,22 @@ struct bridge_mdb_entry {
 	struct epoch_context	bmd_epoch_ctx;
 };
 
+/*
+ * Bridge multicast router entry.  Records a member interface on which IGMP
+ * membership queries have been seen, i.e. a port that leads to a multicast
+ * router.  Router ports receive all snooped multicast for their VLAN in
+ * addition to the learned listener ports, so that pruning does not blackhole
+ * traffic a router needs to relay.  Entries are keyed by (VLAN, port) and
+ * aged like listener membership.
+ */
+struct bridge_mdb_router {
+	CK_LIST_ENTRY(bridge_mdb_router) bmr_next;
+	struct bridge_iflist	*bmr_bif;
+	ether_vlanid_t		bmr_vlan;
+	unsigned long		bmr_expire;
+	struct epoch_context	bmr_epoch_ctx;
+};
+
