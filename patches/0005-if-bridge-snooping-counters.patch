--- a/tests/sys/net/if_bridge_test.sh
+++ b/tests/sys/net/if_bridge_test.sh
@@ -845,6 +845,41 @@ bridge_mdb_vnet_topology_create()
 	ifconfig ${mdb_bridge} addm ${mdb_idle_epair}a
 }
 
+# Compile a small helper that joins a multicast group and holds the socket
+# open.  VNET jails share the host filesystem, so a binary written to /tmp on
+# the host is reachable via jexec without copying.
+bridge_mdb_compile_join_helper()
+{
+	cat > /tmp/mcast_join_bridge_test.c << 'CSRC'
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
+#include <string.h>
+#include <stdlib.h>
+#include <unistd.h>
+int main(int argc, char **argv)
+{
+	struct ip_mreq mreq;
+	int s, on = 1, secs;
+	if (argc != 4) return 1;
+	secs = atoi(argv[3]);
+	s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (s < 0) return 1;
+	setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &on, sizeof(on));
+	memset(&mreq, 0, sizeof(mreq));
+	mreq.imr_multiaddr.s_addr = inet_addr(argv[1]);
+	mreq.imr_interface.s_addr = inet_addr(argv[2]);
+	if (setsockopt(s, IPPROTO_IP, IP_ADD_MEMBERSHIP,
+	    &mreq, sizeof(mreq)) < 0)
+		return 1;
+	sleep(secs);
+	return 0;
+}
+CSRC
+	cc -o /tmp/mcast_join_bridge_test /tmp/mcast_join_bridge_test.c || \
+	    atf_skip "could not compile mcast_join helper"
+}
+
