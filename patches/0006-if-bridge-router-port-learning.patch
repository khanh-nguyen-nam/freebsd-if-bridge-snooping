+/*
+ * Common eligibility test for an MDB forwarding destination: not the source,
+ * not blocked by IFBIF_PRIVATE, not STP-discarding, and running.
+ */
+static bool
+bridge_mdb_dest_ok(struct bridge_iflist *sbif, struct bridge_iflist *dbif,
+    struct ifnet *src_if)
+{
+	if (dbif->bif_ifp == src_if)
+		return (false);
+	if (sbif != NULL &&
+	    (sbif->bif_flags & dbif->bif_flags & IFBIF_PRIVATE))
+		return (false);
+	if ((dbif->bif_flags & IFBIF_STP) &&
+	    dbif->bif_stp.bp_state == BSTP_IFSTATE_DISCARDING)
+		return (false);
+	if ((dbif->bif_ifp->if_drv_flags & IFF_DRV_RUNNING) == 0)
+		return (false);
+	return (true);
+}
+
+/*
+ * Forward one copy of m to dst_if.  The single "last" destination is handed
+ * the original mbuf (setting *used); every other destination gets an m_dup.
+ * Mirrors the per-port replication that bridge_broadcast() performs.
+ */
+static void
+bridge_mdb_forward_one(struct bridge_softc *sc, struct mbuf *m,
+    struct bridge_iflist *dbif, bool last, bool *used)
+{
+	struct ifnet *dst_if = dbif->bif_ifp;
+	struct mbuf *mc;
+	int i;
+
+	if (last) {
+		mc = m;
+		*used = true;
+	} else {
+		mc = m_dup(m, M_NOWAIT);
+		if (mc == NULL) {
+			if_inc_counter(sc->sc_ifp, IFCOUNTER_OERRORS, 1);
+			return;
+		}
+	}
+
+	if (PFIL_HOOKED_OUT_46) {
+		if (!last) {
+			i = min(mc->m_pkthdr.len, max_protohdr);
+			mc = m_copyup(mc, i, ETHER_ALIGN);
+			if (mc == NULL) {
+				if_inc_counter(sc->sc_ifp, IFCOUNTER_OERRORS, 1);
+				return;
+			}
+		}
+		if (bridge_pfil(&mc, NULL, dst_if, PFIL_OUT) != 0)
+			return;
+		if (mc == NULL)
+			return;
+	}
+
+	bridge_enqueue(sc, dst_if, mc);
+}
