+/*
+ * Record that member interface bif leads to a multicast router on the given
+ * VLAN, or refresh the expiry of an existing router entry.  Called for each
+ * IGMP membership query seen on a port.
+ */
+static int
+bridge_mdb_add_router(struct bridge_softc *sc, ether_vlanid_t vlan,
+    struct bridge_iflist *bif, unsigned int lifetime)
+{
+	struct bridge_mdb_router *bmr, *new_bmr;
+
+	new_bmr = malloc(sizeof(*new_bmr), M_DEVBUF, M_NOWAIT | M_ZERO);
+	if (new_bmr != NULL) {
+		new_bmr->bmr_bif = bif;
+		new_bmr->bmr_vlan = vlan;
+	}
+
+	BRIDGE_RT_LOCK(sc);
+	bmr = bridge_mdb_router_lookup(sc, vlan, bif);
+	if (bmr == NULL) {
+		if (new_bmr == NULL) {
+			BRIDGE_RT_UNLOCK(sc);
+			return (ENOMEM);
+		}
+		bmr = new_bmr;
+		new_bmr = NULL;
+		CK_LIST_INSERT_HEAD(&sc->sc_mdbrouters, bmr, bmr_next);
+		sc->sc_mdbroutercnt++;
+		counter_u64_add(V_mdb_routers, 1);
+	}
+	bmr->bmr_expire = lifetime == 0 ? 0 : time_uptime + lifetime;
+	BRIDGE_RT_UNLOCK(sc);
+
+	if (new_bmr != NULL)
+		free(new_bmr, M_DEVBUF);
+
+	return (0);
+}
